{
  "appId": "com.net360prep.app",
  "appName": "NET360 Preparation",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "showSpinner": false,
      "backgroundColor": "#0A1630"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#0A1630"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"],
      "iconColor": "#5B8CFF"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": true,
        "twitter": true
      }
    }
  }
}
