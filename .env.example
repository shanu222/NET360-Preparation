# Optional: set DEBUG_AUTH=true to log non-sensitive login diagnostics (avoid in public production).
# Optional: ALLOW_OPEN_REGISTER=true enables POST /api/auth/register-fallback (emergency use only).
DEBUG_AUTH=
ALLOW_OPEN_REGISTER=

API_PORT=5000
JWT_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# CORS: default reflects browser Origin (works with credentialed cookies). For strict production, set:
# CORS_ALLOWED_ORIGINS=https://your-app.com,https://www.your-app.com
# For two-label hosts (e.g. example.com), the server also allows the www / non-www pair automatically.
# (Must match exactly, no trailing slash. Also applied to Socket.IO.)
# Express allows custom request headers on preflight (e.g. X-Net360-Client-Platform from the SPA).
# If DISABLE_EXPRESS_CORS=true, nginx must echo the same headers in Access-Control-Allow-Headers.
CORS_ALLOWED_ORIGINS=
NET360_CORS_ORIGINS=
# Documented historically; not read by server code — use CORS_ALLOWED_ORIGINS instead.
CORS_ALLOW_VERCEL=false
# If nginx adds Access-Control-Allow-Origin while Express also sets it, browsers reject the response
# ("multiple values ... but only one is allowed"). Remove CORS headers from nginx for this upstream,
# OR set DISABLE_EXPRESS_CORS=true and configure CORS exactly once in nginx.
# Never set one header to two URLs (comma-separated) — invalid; use nginx map to echo $http_origin instead.
DISABLE_EXPRESS_CORS=
MAX_JSON_BODY_MB=10
REQUEST_TIMEOUT_MS=30000

# Redis (optional — cache + Socket.IO scaling). Prefer REDIS_URL OR host/port + credentials.
# Leave all Redis vars empty if you have no Redis (app runs without cache / single-instance sockets).
# Do not use placeholder hostnames — invalid host causes reconnect spam in logs.
# Redis Cloud (host + user + pass, like server/services/redis.js):
#   REDIS_HOST=xxx.redis-cloud.com
#   REDIS_PORT=12345
#   REDIS_USERNAME=default
#   REDIS_PASSWORD=secret
#   REDIS_TLS=true
# Single-line alternative: REDIS_URL=rediss://default:PASSWORD@host:port (TLS) or redis:// for plaintext.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Redis Cloud: true (default below). For local Redis without TLS use REDIS_TLS=false. Omitted + *.redislabs.com host also enables TLS.
REDIS_TLS=true
REDIS_CACHE_PREFIX=
# Short-TTL cache for community/quiz leaderboards (seconds)
COMMUNITY_LEADERBOARD_CACHE_TTL_SEC=15
QUIZ_LEADERBOARD_CACHE_TTL_SEC=15

# PayFast (Pakistan) — automated wallet checkout. Get MERCHANT_ID + SECURED_KEY from PayFast.
# Base URL may differ for sandbox vs production (confirm in PayFast integration pack).
PAYFAST_BASE_URL=https://ipg1.payfastpakistan.com:8443
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
# Issuer bank codes for Easypaisa / JazzCash (from PayFast instrument list — not card BINs).
PAYFAST_BANK_CODE_EASYPAISA=
PAYFAST_BANK_CODE_JAZZCASH=
# Wallet account type id for POST /transaction (often 4 — confirm with PayFast docs for your integration).
PAYFAST_WALLET_ACCOUNT_TYPE_ID=4
# Subscription lengths (optional overrides)
SUBSCRIPTION_TRIAL_DAYS=7
PREMIUM_PLAN_DURATION_MONTHS=6
# Dev only: allow POST /api/payments/mock/complete (never enable in production)
PAYMENT_MOCK_ENABLE=false
# When unset, PayFast checkout is disabled (same as true). Set PAYFAST_CHECKOUT_DISABLED=false only when automated checkout goes live.
PAYFAST_CHECKOUT_DISABLED=true
# When true, signed-in students can use tests, preparation, and community without trial/payment (ops flag until PayFast is on).
SUBSCRIPTION_PREMIUM_SURFACE_BYPASS=true
# WhatsApp for manual premium activation (digits with country code, e.g. 923001234567). Shown on Subscription when checkout is disabled.
MANUAL_SUBSCRIPTION_WHATSAPP=

# Optional: shown by the Vite app if the API does not yet expose MANUAL_SUBSCRIPTION_WHATSAPP.
VITE_MANUAL_SUBSCRIPTION_WHATSAPP=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=50
# Firebase Admin (Railway): prefer JSON secret — do not commit credential files.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or: FIREBASE_SERVICE_ACCOUNT_BASE64=...
# Or: FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Admin login from environment (recommended for simple production admin auth):
# - If email/password match, backend auto-creates/promotes admin user and syncs password.
# - Aliases supported: ADMIN_EMAIL/ADMIN_PASSWORD and BOOTSTRAP_ADMIN_*.
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
# Optional legacy bootstrap for startup-time sync.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FORCE_PASSWORD_RESET=true
ALLOW_WEAK_JWT_BOOTSTRAP=

# AES-256-GCM key for optional encrypted copy of security answer (admin plaintext view only; bcrypt remains canonical).
# Generate: openssl rand -base64 32   (must decode to 32 bytes) or 64 hex chars.
SECURITY_ANSWER_ENCRYPTION_KEY=

# Auth hardening — Android needs ISSUE_AUTH_BODY_TOKENS=true
ISSUE_AUTH_BODY_TOKENS=true
# Allow access token in query string (e.g. legacy SSE). Prefer false in production.
ALLOW_QUERY_TOKEN_AUTH=
# Verbose auth/login logging (server). Default off in production.
NET360_AUTH_DEBUG=
# Structured login/session audit logs (request, takeover, session ids). Set to 1 in production if needed.
NET360_AUTH_LOGIN_AUDIT=
# If true, POST /api/auth/login returns 409 when another deviceId has activeSession. Default true in code.
REQUIRE_CONFIRM_FOR_DEVICE_LOGIN=
# Log every HTTP request (server). Default off in production; set to 1 to enable.
NET360_LOG_REQUESTS=
# HttpOnly auth cookies: secure=true and SameSite=None when NODE_ENV=production (HTTPS API required for browsers).
# Development uses secure=false and SameSite=lax.

# Password recovery providers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=

# Frontend (Vite). Set VITE_API_URL to your Express origin (same host or api.*).
# Local dev: create `.env` or `.env.development` with e.g. VITE_API_URL=http://localhost:5000
# Production: Vercel should set VITE_API_URL=https://api.net360preparation.com (not the static Vercel app URL).
# VITE_API_BASE_URL is read as an alias when VITE_API_URL is unset (fix dashboards that used the wrong name).
VITE_API_URL=http://localhost:5000
# VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Student app: set true for Capacitor / WebViews that must store JWTs in localStorage (default: false in production builds).
VITE_STORE_AUTH_TOKENS=

# Public media overrides (optional). Static assets ship in frontend public/ — no AWS/S3.
PUBLIC_MEDIA_BASE_URL=
PUBLIC_BRAND_LOGO_URL=
PUBLIC_USER_GUIDE_VIDEO_URL=
PUBLIC_LOGIN_BANNER_URL=
PUBLIC_APP_PROMO_IMAGE_URL=
PUBLIC_MEDIA_ASSET_VERSION=
PUBLIC_APP_PROMO_ASSET_VERSION=
PUBLIC_FAVICON_URL=
PUBLIC_SCHOOLS_PATH_PREFIX=

# Optional Vite asset URL overrides (prefer bundled public/ paths).
VITE_BRAND_LOGO_URL=
VITE_USER_GUIDE_VIDEO_URL=
VITE_LOGIN_BANNER_URL=
VITE_APP_PROMO_IMAGE_URL=
VITE_APP_PROMO_ASSET_VERSION=

# Railway / build metadata (optional)
# GIT_COMMIT=
# GIT_BRANCH=
# DEPLOYED_AT=
# BUILD_HOST=
